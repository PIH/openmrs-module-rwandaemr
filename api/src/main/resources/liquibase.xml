        <addForeignKeyConstraint constraintName="fk_icd11_diagnosis_obs_group"
                                 baseTableName="rwandaemr_icd11_patient_diagnosis" baseColumnNames="obs_group_id"
                                 referencedTableName="obs" referencedColumnNames="obs_id"/>
        <createIndex tableName="rwandaemr_icd11_patient_diagnosis" indexName="idx_icd11_diagnosis_obs_group">
            <column name="obs_group_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260531-add-icd11-code-cache" author="rwandaemr">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="rwandaemr_icd11_code_cache"/></not>
        </preConditions>
        <createTable tableName="rwandaemr_icd11_code_cache">
            <column name="icd11_code_cache_id" type="int" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="cache_key" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="icd11_code" type="varchar(50)"/>
            <column name="entity_uri" type="varchar(512)"/>
            <column name="foundation_uri" type="varchar(512)"/>
            <column name="title" type="varchar(500)"/>
            <column name="linearization" type="varchar(100)"/>
            <column name="language" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="api_version" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="response_json" type="mediumtext">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="creator" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="date_created" type="datetime">
                <constraints nullable="false"/>
            </column>
            <column name="changed_by" type="int"/>
            <column name="date_changed" type="datetime"/>
            <column name="voided" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="voided_by" type="int"/>
            <column name="date_voided" type="datetime"/>
            <column name="void_reason" type="varchar(255)"/>
            <column name="uuid" type="char(38)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_icd11_cache_creator"
                                 baseTableName="rwandaemr_icd11_code_cache" baseColumnNames="creator"
                                 referencedTableName="users" referencedColumnNames="user_id"/>
        <addForeignKeyConstraint constraintName="fk_icd11_cache_changed_by"
                                 baseTableName="rwandaemr_icd11_code_cache" baseColumnNames="changed_by"
                                 referencedTableName="users" referencedColumnNames="user_id"/>
        <addForeignKeyConstraint constraintName="fk_icd11_cache_voided_by"
                                 baseTableName="rwandaemr_icd11_code_cache" baseColumnNames="voided_by"
                                 referencedTableName="users" referencedColumnNames="user_id"/>
        <createIndex tableName="rwandaemr_icd11_code_cache" indexName="idx_icd11_cache_code">
            <column name="icd11_code"/>
        </createIndex>
        <createIndex tableName="rwandaemr_icd11_code_cache" indexName="idx_icd11_cache_expires_at">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="20260531-add-icd11-concept-map" author="rwandaemr">
        <preConditions onFail="MARK_RAN">
