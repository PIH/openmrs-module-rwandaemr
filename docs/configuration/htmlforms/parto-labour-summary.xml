    <script>
                                                  
        
        
        
        
        
        <![CDATA[
    // Live alert-highlighting for numeric obs fields.
    // The id given on each obs tag is passed through to the rendered
    // input by HTML Form Entry, so we can hook directly into it here.
    // This ONLY toggles a CSS class -- it never changes the submitted value,
    // so obs are still saved against their original conceptId as normal.
    (function () {
      var rules = [
        { id: 'bloodLossId', test: function (v) { return v >= 500; } }
      ];

      function wire(rule) {
        var el = document.getElementById(rule.id);
        if (!el) { return; }
        var check = function () {
          var v = parseFloat(el.value);
          var bad = el.value !== '' &amp;&amp; !isNaN(v) &amp;&amp; rule.test(v);
          if (bad) {
            el.classList.add('alert-value');
          } else {
            el.classList.remove('alert-value');
          }
        };
        el.addEventListener('input', check);
        el.addEventListener('change', check);
        check();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
          rules.forEach(wire);
        });
      } else {
        rules.forEach(wire);
      }
    })();
  ]]>
                                                  
    
    
    
    
    
    </script>
                          
    
    
    
    
    
